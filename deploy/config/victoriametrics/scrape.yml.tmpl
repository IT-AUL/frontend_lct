global:
  scrape_interval: 30s
  scrape_timeout: 15s

scrape_configs:
  - job_name: victoriametrics
    static_configs:
      - targets: ["victoria-metrics:8428"]

  - job_name: victorialogs
    static_configs:
      - targets: ["victoria-logs:9428"]

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          host: deckdna-host

  - job_name: cadvisor
    scrape_interval: 30s
    static_configs:
      - targets: ["cadvisor:8080"]

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]

  - job_name: probe_internal
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["http://web/healthz"]
        labels: {check: web_internal}
      - targets: ["http://api:8000/api/v1/health/ready"]
        labels: {check: api_ready}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115

  - job_name: probe_public
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["https://${APP_DOMAIN}/healthz"]
        labels: {check: app_public}
      - targets: ["https://${APP_DOMAIN}/api/v1/health/ready"]
        labels: {check: api_public}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115

  - job_name: probe_ops
    metrics_path: /probe
    params:
      module: [http_any]
    static_configs:
      - targets: ["https://${OPS_DOMAIN}/login"]
        labels: {check: ops_public}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
